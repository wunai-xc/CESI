// cesi/wrangler.jsonc
// Cloudflare Workers 静态资源部署配置（可选方案）。
// 本项目是纯静态导出（next.config.ts 里 output: "export"），产物在 out/，
// 所以这里只需要把 out/ 当静态资源发布，不要挂任何 Worker 脚本，也不需要 OpenNext。
//
// 若走 Workers 部署：
//   Cloudflare 项目设置里把 Framework preset 改成 None（否则它会把项目改造成 OpenNext 模式）、
//   Build command 用 `npm run build`，Deploy command 用 `npx wrangler deploy`。
// 若走 Pages（更简单）：
//   Build command `npm run build`，Build output directory `out`，这个文件会被忽略。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cesi",
  "compatibility_date": "2025-10-31",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
